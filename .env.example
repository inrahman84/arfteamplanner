# Already present on many Vercel Supabase integrations (recommended):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Alternative (older projects):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_LEGACY_PUBLIC_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# IMPORTANT: SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY must NEVER be included in public/client code.
